# wpa_supplicant build options (wpa/build.sh copies this to wpa_supplicant/.config):
# WPA2/WPA3 personal on nl80211, a control socket and a debug file; no EAP, WPS, P2P or D-Bus.
CONFIG_DRIVER_NL80211=y
CONFIG_LIBNL32=y
CONFIG_CTRL_IFACE=y
CONFIG_BACKEND=file
CONFIG_DEBUG_FILE=y
CONFIG_TLS=openssl
CONFIG_SAE=y
CONFIG_IEEE80211N=y
CONFIG_IEEE80211AC=y
