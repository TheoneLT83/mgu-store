[Unit]
Description=mgu-render page template for the HMI
DefaultDependencies=no
Before=hmi.service
RequiresMountsFor=/var/opt/mgu-render /mnt/dataro/data/hmi

[Service]
Type=oneshot
RemainAfterExit=yes
# Mounts the template made at install, nothing more: without one for this HmiMain3D, on any failure,
# or after 30 s, the stock widgets stay and the HMI starts as usual.
TimeoutStartSec=30
ExecStart=-/bin/sh /var/opt/mgu-render/current/mgu-render-hmi.sh /var/opt/mgu-render/current /var/opt/mgu-render/hmi

[Install]
WantedBy=hmi.service
