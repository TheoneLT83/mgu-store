[Unit]
Description=mgu-deploy: remove files a tool handed over once no process runs them
RequiresMountsFor=/var/opt
After=multi-user.target
ConditionPathExists=/var/opt/mgu-deploy/remove-when-unused.json

[Service]
Type=simple
# waits for the deploy tool's lock; what it could not remove waits for the
# next start, and the unit always ends as succeeded
ExecStart=-/bin/sh /var/opt/mgu-deploy/mgu-deploy.sh remove-unused

[Install]
WantedBy=late.target
